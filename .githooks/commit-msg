#!/bin/sh
#
# 一刻 —— 提交信息格式门禁（Conventional Commits）
#
# 启用：npm run setup
# 临时跳过：git commit --no-verify
#
# 见 docs/代码审查标准与流程.md §6

msg_file="$1"
subject=$(head -n 1 "$msg_file")

# 合并 / revert / fixup 自动生成的信息放行
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*|"") exit 0 ;;
esac

if printf '%s' "$subject" | grep -qE '^(feat|fix|refactor|perf|test|docs|chore|build|ci|style|revert)(\([a-z0-9./-]+\))?!?: .+'; then
  exit 0
fi

echo "✗ 提交信息不符合规范：" >&2
echo "      $subject" >&2
echo "" >&2
echo "  应为：<type>(<scope>): <描述>" >&2
echo "  type：feat | fix | refactor | perf | test | docs | chore | build | ci | style | revert" >&2
echo "  示例：fix(sync): 修复 pending 为空时的越界读取" >&2
echo "" >&2
echo "  详见 docs/代码审查标准与流程.md §6" >&2
exit 1
